# GitHub OAuth App values. Keep the secret out of git and out of the image.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Comma-separated browser origins allowed to call this proxy.
ALLOWED_ORIGINS=https://classroom50.org,https://preview.classroom50.org,https://classroom50.htlweiz.at

PORT=8787